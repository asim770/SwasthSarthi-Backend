# Server Environment Configuration (SwasthSaarthi Backend)

NODE_ENV=development
PORT=3000

# MongoDB Connection String (No real credentials, local example)
MONGODB_URI=mongodb://127.0.0.1:27017/swasth_saarthi

# Redis Configuration (Used for BullMQ background workers)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Allowed CORS Origins (Comma-separated list of trusted client origins)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Authentication & Session Security (Development placeholders, change in production)
OTP_PEPPER=swasth_saarthi_demo_otp_pepper_2026
CSRF_PEPPER=swasth_saarthi_demo_csrf_pepper_2026
SESSION_MAX_AGE_SECONDS=86400
SESSION_INACTIVITY_TIMEOUT_SECONDS=7200

# OTP Delivery Provider Configuration
# Delivery mode: 'mock' (local/testing simulated), 'real' (live SMS/Email only), 'hybrid' (both enabled)
OTP_DELIVERY_MODE=mock
# Comma-separated enabled delivery channels: mock,sms,email
OTP_CHANNELS_ENABLED=mock,sms,email

# Resend Email Delivery Provider (https://resend.com/docs)
# Obtain from Resend Dashboard -> API Keys (starts with re_...)
RESEND_API_KEY=
# Authorized sender address (e.g., onboarding@resend.dev for test accounts, or your verified domain sender)
RESEND_FROM_EMAIL=onboarding@resend.dev

# MSG91 SMS Delivery Provider (https://docs.msg91.com/otp)
# Obtain Authkey from MSG91 Dashboard -> Developer -> Authkey
MSG91_AUTH_KEY=
# OTP Flow Template ID configured in MSG91 -> OTP Templates (requires DLT registration for Indian routes)
MSG91_OTP_TEMPLATE_ID=

# OTP Challenge Security & Rate Limiting Policy
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=3
OTP_RESEND_COOLDOWN_SECONDS=30
OTP_MAX_SENDS_PER_WINDOW=3
OTP_MAX_VERIFY_ATTEMPTS_PER_WINDOW=5

